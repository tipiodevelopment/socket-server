          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "  const r = pm.response.json();",
                  "  console.log(`[catalog] sponsor=${r.sponsor.name} returned=${r.products.length}/${r.total} hasMore=${r.hasMore}`);",
                  "  pm.test('has sponsor block', () => pm.expect(r.sponsor.id).to.be.a('number'));",
                  "  pm.test('products is array', () => pm.expect(r.products).to.be.an('array'));",
                  "} catch (e) { console.error('parse error', e); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
