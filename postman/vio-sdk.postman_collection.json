            },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/broadcasts/{{broadcastId}}/sponsor-slots/:slotId/execute",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "broadcasts",
                "{{broadcastId}}",
                "sponsor-slots",
                ":slotId",
                "execute"
              ],
              "variable": [
                {
                  "key": "slotId",
                  "value": "1"
                }
              ]
            },
            "description": "Fires a pre-configured slot. Persists `source='slot-scheduler'` with `slot_id`."
          }
        },
        {
          "name": "GET /api/broadcasts/{id}/shoppable-ads (audit list)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
