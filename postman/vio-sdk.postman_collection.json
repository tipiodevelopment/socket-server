          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "try {",
                  "  const r = pm.response.json();",
                  "  if (r.activationId) pm.collectionVariables.set('activationId', String(r.activationId));",
                  "} catch (e) {}"
