# Local development — copy to .env and fill in values
DATABASE_URL=postgresql://pgadmin:localpass@localhost:5432/socket_server

# Azure Storage for db snapshots (get from: az storage account show-connection-string --name containerqa2 --resource-group qa -o tsv)
AZURE_STORAGE_CONNECTION_STRING=

# Optional: your name shown in snapshot filenames (defaults to git user.name)
# DB_SNAPSHOT_AUTHOR=angelo
